# Inside the web container. TLS happens in the host Caddy (ops/caddy/retro-cable.caddy);
# this serves plain HTTP on the compose network. No access log: media URLs carry signatures
# and must never be logged.
{
	admin off
	auto_https off
}

:80 {
	# LAN only here too: the host Caddy checks first, but RC_WEB_BIND can publish this port
	# on the LAN (mini:8095), and then this is the only check. Docker keeps the client's
	# address on a published port; the host Caddy and loopback are private addresses.
	@not_lan not remote_ip private_ranges
	abort @not_lan

	encode gzip

	handle_path /api/* {
		reverse_proxy {$RC_API_UPSTREAM:api:8000}
	}

	# Signed media (/media/<path>?exp=&sig=): the API checks the signature of the original
	# URI (X-Forwarded-Uri) and answers 204 or 403; only then does file_server send bytes,
	# with byte ranges. `route` keeps this order.
	handle /media/* {
		route {
			forward_auth {$RC_API_UPSTREAM:api:8000} {
				uri /media-auth
			}
			uri strip_prefix /media
			root * /srv/media
			file_server
		}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
