# Inside the web container. TLS and the LAN-only check happen in the host Caddy
# (ops/caddy/retro-cable.caddy); this serves plain HTTP on the compose network.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	handle_path /api/* {
		reverse_proxy {$RC_API_UPSTREAM:api:8000}
	}

	# Phase 4 adds signed-URL checks in front of this.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
