{
  "$defs": {
    "Synthetic": {
      "additionalProperties": false,
      "description": "A transplant: a show (or movie) given a made-up premiere inside 1990-2010 on one\nchannel. Its earliest episode airs on that channel from `premiere`, the rest keep their\nspacing; every other channel keeps the real (or US debut) dates.",
      "properties": {
        "channel": {
          "description": "The one channel the pretend premiere applies to",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Channel",
          "type": "string"
        },
        "mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the channel's transplant_mark",
          "title": "Mark"
        },
        "premiere": {
          "description": "The pretend first air date on that channel",
          "format": "date",
          "title": "Premiere",
          "type": "string"
        },
        "show": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Show",
          "type": "string"
        }
      },
      "required": [
        "show",
        "channel",
        "premiere"
      ],
      "title": "Synthetic",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "synthetic": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Synthetic"
      },
      "title": "Synthetic",
      "type": "array"
    }
  },
  "title": "catalog/synthetic.yaml",
  "type": "object"
}
