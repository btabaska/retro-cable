{
  "$defs": {
    "ShowOverride": {
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "default": {},
          "description": "Per-episode air dates",
          "patternProperties": {
            "^S\\d{1,3}E\\d{1,4}$": {
              "format": "date",
              "type": "string"
            }
          },
          "title": "Episodes",
          "type": "object"
        },
        "exclude": {
          "default": false,
          "title": "Exclude",
          "type": "boolean"
        },
        "holiday_tags": {
          "default": {},
          "description": "Per-episode holiday ids, replacing the title tagger",
          "patternProperties": {
            "^S\\d{1,3}E\\d{1,4}$": {
              "items": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Holiday Tags",
          "type": "object"
        },
        "plex_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plex title if not the carriage title",
          "title": "Plex Title"
        },
        "seasonal": {
          "default": false,
          "description": "Holiday specials show: tagged episodes air only in their holiday's season",
          "title": "Seasonal",
          "type": "boolean"
        },
        "show": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Show",
          "type": "string"
        },
        "us_debut": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Imports: first US air date",
          "title": "Us Debut"
        }
      },
      "required": [
        "show"
      ],
      "title": "ShowOverride",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "shows": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ShowOverride"
      },
      "title": "Shows",
      "type": "array"
    }
  },
  "title": "catalog/overrides.yaml",
  "type": "object"
}
