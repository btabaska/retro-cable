{
  "$defs": {
    "PartOf": {
      "additionalProperties": false,
      "description": "A show TheTVDB files as seasons of another series (Justice League Unlimited is\nJustice League seasons 3-5). The library keeps the series' files under its own id; the\nscheduler reads these seasons as this show, and acquire asks Sonarr for just them.",
      "properties": {
        "seasons": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seasons",
          "type": "array"
        },
        "show": {
          "description": "The series' id in the library (its folder title's slug)",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Show",
          "type": "string"
        },
        "tvdb_id": {
          "description": "The series' TheTVDB id, for Sonarr",
          "minimum": 1,
          "title": "Tvdb Id",
          "type": "integer"
        }
      },
      "required": [
        "show",
        "tvdb_id",
        "seasons"
      ],
      "title": "PartOf",
      "type": "object"
    },
    "ShowOverride": {
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "default": {},
          "description": "Per-episode air dates",
          "patternProperties": {
            "^S\\d{1,3}E\\d{1,4}$": {
              "format": "date",
              "type": "string"
            }
          },
          "title": "Episodes",
          "type": "object"
        },
        "exclude": {
          "default": false,
          "title": "Exclude",
          "type": "boolean"
        },
        "holiday_tags": {
          "default": {},
          "description": "Per-episode holiday ids, replacing the title tagger",
          "patternProperties": {
            "^S\\d{1,3}E\\d{1,4}$": {
              "items": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Holiday Tags",
          "type": "object"
        },
        "part_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartOf"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seasons of another series (TheTVDB files them as one)"
        },
        "plex_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plex title if not the carriage title",
          "title": "Plex Title"
        },
        "seasonal": {
          "default": false,
          "description": "Holiday specials show: tagged episodes air only in their holiday's season",
          "title": "Seasonal",
          "type": "boolean"
        },
        "show": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Show",
          "type": "string"
        },
        "tmdb_id": {
          "anyOf": [
            {
              "description": "A TMDB id: tv:N or movie:N",
              "pattern": "^(tv|movie):[1-9][0-9]{0,9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TMDB id from the lineup; ingest acquire looks titles up by it",
          "title": "Tmdb Id"
        },
        "us_debut": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Imports: first US air date",
          "title": "Us Debut"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year it first aired (a movie: released), for acquire's title+year lookup",
          "title": "Year"
        }
      },
      "required": [
        "show"
      ],
      "title": "ShowOverride",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "shows": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ShowOverride"
      },
      "title": "Shows",
      "type": "array"
    }
  },
  "title": "catalog/overrides.yaml",
  "type": "object"
}
