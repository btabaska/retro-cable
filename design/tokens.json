{
  "$description": "Shared design tokens. Web reads them as CSS variables (--rc-<group>-<name>); tvOS will read them as Swift constants. Values come from docs/mockups/.",
  "color": {
    "background": "#0B1E4A",
    "header": "#06112E",
    "rule": "#2E5AAC",
    "channel": "#102A63",
    "cell": "#1C3A7A",
    "cellPast": "#16306A",
    "focus": "#F2C230",
    "onFocus": "#0B1E4A",
    "text": "#FFFFFF",
    "textMuted": "#B9C8EA",
    "textDim": "#8FA3D1",
    "holiday": "#FF9F1C",
    "holidayMuted": "#E0A458",
    "transplant": "#7FD1FF",
    "black": "#000000"
  },
  "font": {
    "body": "'Arimo', Arial, sans-serif",
    "grid": "'Archivo Narrow', Arial, sans-serif"
  },
  "fontSize": {
    "caption": "16px",
    "small": "22px",
    "body": "26px",
    "label": "30px",
    "clock": "36px",
    "heading": "44px",
    "title": "60px"
  },
  "space": {
    "cellGap": "4px",
    "rowGap": "6px",
    "cellPad": "12px",
    "gutter": "64px"
  },
  "radius": {
    "button": "6px",
    "badge": "4px"
  },
  "screen": {
    "width": 1920,
    "height": 1080
  },
  "admin": {
    "$description": "The /admin phone palette and scale (docs/mockups/Admin*). Becomes --rc-admin-*.",
    "bg": "#F4F6FB",
    "surface": "#FFFFFF",
    "ink": "#0B1E4A",
    "inkMuted": "#4A5878",
    "accent": "#1C3A7A",
    "border": "#D5DCEB",
    "draftBorder": "#8A96B2",
    "warn": "#8A5A00",
    "error": "#B3261E",
    "transplant": "#2B8FC4",
    "fontCaption": "12px",
    "fontMeta": "14px",
    "fontBody": "15px",
    "fontValue": "16px",
    "fontHeading": "24px",
    "radiusRow": "8px",
    "radiusCard": "10px"
  }
}
