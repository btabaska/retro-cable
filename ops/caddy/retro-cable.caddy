# Retro Cable site block for the homelab Caddy. Add to the host Caddyfile:
#   import /path/to/retro-cable/ops/caddy/retro-cable.caddy
# The certificate comes from the DNS-01 challenge configured in the host Caddy's global options.
# LAN only: anything outside private ranges is dropped. Never add a port forward for this site.

tv.home.tabaska.us {
	@not_lan not remote_ip private_ranges
	abort @not_lan

	reverse_proxy 127.0.0.1:{$RC_WEB_PORT:8080}
}
