# Copy to ops/.env on the homelab host (readable only by the deploy user). Never commit .env.
# RC_WEB_BIND=127.0.0.1     # interface the web container listens on; keep loopback if Caddy is on this host
# RC_WEB_PORT=8080
# RC_DATA_DIR=/srv/retro-cable/data

# Media (Phase 4). Signed /media URLs need one stable secret shared by every api process:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# RC_MEDIA_SECRET=<64 hex characters>
# Normalized MP4s: read-only for api and web, written only by the worker.
# RC_MEDIA_DIR=/srv/retro-cable/media
# Raw sources (the Plex-named TV and movie trees), mounted read-only into the worker at /sources.
# RC_SOURCE_DIR=/srv/retro-cable/sources
# Rewrite source paths recorded by Plex or `ingest scan` to where the worker sees them, FROM=TO,
# comma-separated, e.g. /volume3/tv=/sources/tv,/volume2/movies=/sources/movies
# RC_SOURCE_MAP=
# Encoder for `ingest normalize`: x264 (CPU, default) or nvenc (NVIDIA GPU).
# RC_ENCODER=x264
# Catalog YAML mounted read-only at /catalog (defaults to the checkout's catalog/).
# RC_CATALOG_SRC=../catalog

# The channel builder (python -m retro_cable.channel_builder, docs/specs/catalog.md, M3) and the
# weekly station manager (M5: in the api container every Sunday at 2 AM, ops/systemd/) ask the
# rig's local models through LiteLLM; never a cloud model. The mini's values are below.
# RC_LLM_URL=http://rig:4000          # the mini: http://192.168.10.12:4000
# RC_LLM_KEY=               # a LiteLLM key (the rig's LITELLM_MASTER_KEY or a virtual key); never logged
# RC_LLM_MODEL=chat         # a LiteLLM alias on the rig
# RC_STATION_AUTO_APPLY=1   # 1 (default): apply each week's changes (undo in /admin); 0: propose only

# Nightly backups (Phase 8, ops/backup.sh, 1 AM by the systemd timer): the database is kept in
# the data dir's backups/ and copied to this folder on the NAS, which must already exist (a
# missing folder means the share isn't mounted). The mini mounts the NAS backups share there.
# RC_BACKUP_DIR=/mnt/nas-backups/retro-cable

# The Sunday report (Phase 8, ops/weekly-report.sh, 8 AM by the systemd timer) is saved for
# /admin's Report tab and, with RC_NTFY_URL set, pushed to the homelab's ntfy (a topic URL on
# the LAN). RC_NTFY_TOKEN only when the topic needs one; never logged. RC_REPORT_LINK is
# where tapping the push goes.
# RC_NTFY_URL=              # e.g. http://192.168.10.2:8080/retro-cable
# RC_NTFY_TOKEN=            # an ntfy access token with write access to that topic
# RC_REPORT_LINK=           # e.g. https://tv.home.tabaska.us/admin

# PLEX_URL=                 # worker only
# PLEX_TOKEN=               # worker only
# TMDB_TOKEN=               # a TMDB v4 read access token; the app's only call outside the LAN

# The mini: the rig worker (ops/rig/) converts into the NAS LiveTV share (volume1), which the
# mini mounts read-only (see docs/specs/ops.md, "Media worker (rig)"); point RC_MEDIA_DIR at
# that mount and turn on the media-index service, which records new encodes from the
# folder's manifest.json every RC_INDEX_EVERY seconds without a redeploy.
# RC_MEDIA_DIR=/mnt/nas-livetv
# COMPOSE_PROFILES=media-index
# RC_INDEX_EVERY=300
# With TMDB_TOKEN set, add the tmdb profile (COMPOSE_PROFILES=media-index,tmdb): it fills air
# dates the library lacks, by the lineup's TMDB ids, every RC_TMDB_EVERY seconds.
# RC_TMDB_EVERY=21600

# Mac mini values shown.
RC_WEB_PORT=8095                       # loopback port for smoke.sh; 8080 is taken on the mini
# RC_WEB_BIND=127.0.0.1
# RC_EDGE_NETWORK=edge                 # Docker network shared with the homelab Caddy
# RC_DATA_DIR=/opt/retro-cable-data    # SQLite catalog and profiles
# RC_MEDIA_DIR=/mnt/nas-livetv    # the rig's encodes on the NAS, mounted read-only
# COMPOSE_PROFILES=media-index
# RC_IMAGE_SOURCE=build                # build from the checkout until a GHCR read token is set up
