# Copy to ops/.env on the homelab host (readable only by the deploy user). Never commit .env.
# Mac mini values shown.
RC_WEB_PORT=8095                       # loopback port for smoke.sh; 8080 is taken on the mini
# RC_WEB_BIND=127.0.0.1
# RC_EDGE_NETWORK=edge                 # Docker network shared with the homelab Caddy
# RC_DATA_DIR=/opt/retro-cable-data    # SQLite catalog and profiles
# RC_MEDIA_DIR=/mnt/nas/retro-cable    # normalized media on the NAS, mounted read-only
# RC_IMAGE_SOURCE=build                # build from the checkout until a GHCR read token is set up
# TMDB_API_KEY=                        # Phase 2, worker only
