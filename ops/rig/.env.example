# Copy to ops/rig/.env on the rig to change the defaults. Never commit .env.
# Host mounts (fstab automounts on the rig): sources read-only, the LiveTV share rw.
# RC_RIG_TV=/mnt/nas-tv-ro
# RC_RIG_MOVIES=/mnt/nas-movies-ro
# RC_RIG_MEDIA=/mnt/nas-livetv
# RC_RIG_MEDIA_SHARE=LiveTV
# hevc (default here; hvc1 for Safari/tvOS/Chrome) or h264.
# RC_CODEC=hevc
# The worker's own database, on the rig's local disk (SQLite over SMB is not safe).
# RC_RIG_DATA=./data
# RC_RIG_UID=1000
# RC_RIG_GID=1000
# auto (NVENC while the GPU is idle, else x264), x264 (CPU only) or nvenc.
# RC_ENCODER=auto
# ComfyUI's queue through the gpu-arbiter; empty to skip the check.
# RC_GPU_QUEUE_URL=http://host.docker.internal:8189
# The mini's admin library, so shows on channels made in the mini's /admin are converted
# too (only carried shows are), e.g. https://tv.home.tabaska.us/api/admin/library
# RC_PRIORITY_URL=
# Seconds between looks for new files after a full pass (default 6 h).
# RC_WORKER_INTERVAL=21600
# Seconds between manifest.json rewrites during a pass (default 5 min).
# RC_MANIFEST_EVERY=300
