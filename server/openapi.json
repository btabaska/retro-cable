  "info": {
    "title": "Retro Cable"
  },
  "openapi": "3.1.0",
  "paths": {
    "/channels": {
      "get": {
        "description": "Every channel with its identity on that date; hidden ones have on_air false.",
        "operationId": "getChannels",
        "parameters": [
          {
            "description": "Simulated year",
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "description": "Simulated year",
              "maximum": 2010,
              "minimum": 1990,
              "title": "Year",
              "type": "integer"
            }
          },
          {
            "description": "MM-DD; defaults to today's date",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "MM-DD; defaults to today's date",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lineup"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Getchannels"
      }
    },
    "/guide": {
      "get": {
        "description": "Back-to-back slots for every channel on the dial, from `start` for `hours`.",
        "operationId": "getGuide",
        "parameters": [
          {
            "description": "Simulated year",
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "description": "Simulated year",
              "maximum": 2010,
              "minimum": 1990,
              "title": "Year",
              "type": "integer"
            }
          },
          {
            "description": "MM-DD; defaults to today's date",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "MM-DD; defaults to today's date",
              "title": "Date"
            }
          },
          {
            "description": "Local HH:MM",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "default": "00:00",
              "description": "Local HH:MM",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": 24,
              "exclusiveMinimum": 0,
              "maximum": 36,
              "title": "Hours",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guide"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Getguide"
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
